# Copy to .env and fill with your Neon connection string.
# Example: DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/nexanet?sslmode=require"
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/nexanet?sslmode=require"
AUTH_SECRET="replace-this-with-a-random-secret-of-at-least-32-characters"
AI_PROVIDER=mock
OPENAI_API_KEY=
# Optional demo credentials used by the seed script. Change them before deployment.
DEMO_ADMIN_EMAIL="admin@nexanet.local"
DEMO_ADMIN_PASSWORD="AdminDemo!2026"
DEMO_STUDENT_EMAIL="siswa@nexanet.local"
DEMO_STUDENT_PASSWORD="BelajarDemo!2026"
DEMO_STUDENT_2_EMAIL="siswa2@nexanet.local"
DEMO_STUDENT_2_PASSWORD="BelajarSiswa2!2026"
DEMO_STUDENT_3_EMAIL="siswa3@nexanet.local"
DEMO_STUDENT_3_PASSWORD="BelajarSiswa3!2026"
OPENAI_MODEL=gpt-5
APP_URL="http://localhost:3000"
# Optional password-reset email delivery through Resend.
RESEND_API_KEY=
EMAIL_FROM=
