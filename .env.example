DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&schema=nexanet_app"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&schema=nexanet_app"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Neon Object Storage (S3-compatible). Keep credentials server-side only.
AWS_ENDPOINT_URL_S3="https://YOUR-BRANCH.storage.c-3.ap-southeast-1.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"

# Optional: AI tutor (defaults to deterministic mock responses)
AI_PROVIDER="mock"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5"

# Optional: account recovery email. Required to enable password recovery in production.
